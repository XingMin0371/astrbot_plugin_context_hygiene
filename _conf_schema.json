{
  "basic": {
    "description": "基础设置",
    "hint": "默认只清理本轮请求，不写会话数据库。",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用节省上下文",
        "hint": "关闭后所有自动和手动清理都停止。",
        "type": "bool",
        "default": true
      },
      "threshold_chars": {
        "description": "压缩触发字符数",
        "hint": "按窗口推荐（字符）：24条→65,000；48条→87,000；72条→110,000；90条→124,000；极限→145,000。",
        "type": "int",
        "default": 110000
      },
      "threshold_tokens": {
        "description": "压缩触发估算 Token",
        "hint": "按窗口推荐（Token）：24条→36,000；48条→48,000；72条→60,500；90条→68,000；极限→80,000。",
        "type": "int",
        "default": 60500
      },
      "keep_recent_turns": {
        "description": "保留最近轮数",
        "hint": "计算：上下文窗口条数 ÷ 6（约每轮 2 条消息）。推荐 4/8/12/15/极限；极限 25 轮。",
        "type": "int",
        "default": 12
      },
      "cache_guard_minutes": {
        "description": "活跃缓存保护（分钟）",
        "hint": "按窗口推荐：24条→45分钟；48条→60分钟；72条→75分钟；90条→90分钟；极限→120分钟。",
        "type": "int",
        "default": 75
      },
      "auto_threshold": {
        "description": "自动按模型窗口计算压缩阈值",
        "type": "bool",
        "default": false,
        "hint": "默认关闭；关闭时使用固定的“压缩触发估算 Token”和“压缩触发字符数”。"
      },
      "threshold_ratio": {
        "description": "普通压缩阈值比例",
        "type": "float",
        "default": 0.536,
        "hint": "自动阈值默认关闭；仅在开启自动模式时生效。"
      }
    }
  },
  "memory_blocks": {
    "description": "只清理历史里重复注入的记忆副本，不删除记忆。",
    "hint": "只清理历史里重复注入的记忆副本，不删除记忆。",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用记忆块清理",
        "type": "bool",
        "default": true
      },
      "keep_latest": {
        "description": "保留最新记忆块份数",
        "type": "int",
        "default": 5,
        "hint": "默认保留最近 5 份。"
      },
      "min_age_hours": {
        "description": "记忆块最短保留小时数",
        "type": "float",
        "default": 12,
        "hint": "默认 12 小时；没有时间戳时按插件第一次看到该块的时间计算。"
      }
    }
  },
  "turn_guard": {
    "description": "工具循环守卫（请求级）",
    "hint": "只改本轮请求：超过步数/工具次数/时间/新增Token，或重复调用时禁用后续工具并收尾；不改历史前缀。",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用工具循环守卫",
        "type": "bool",
        "default": true
      },
      "interactive": {
        "description": "前台/普通聊天预算",
        "type": "object",
        "items": {
          "max_steps": {
            "description": "最多模型步数",
            "type": "int",
            "default": 15
          },
          "max_tool_calls": {
            "description": "最多工具调用次数",
            "type": "int",
            "default": 5
          },
          "max_turn_seconds": {
            "description": "单轮最长秒数",
            "type": "int",
            "default": 120
          },
          "max_turn_new_tokens": {
            "description": "一条用户消息完整轮次新增 Token 上限",
            "type": "int",
            "default": 6000,
            "hint": "只估算本轮新增，不含缓存命中的历史；包含本轮所有模型与工具步骤，不是单次工具调用。0=不限。"
          }
        }
      },
      "background": {
        "description": "后台/定时任务预算",
        "type": "object",
        "items": {
          "max_steps": {
            "description": "最多模型步数",
            "type": "int",
            "default": 24
          },
          "max_tool_calls": {
            "description": "最多工具调用次数",
            "type": "int",
            "default": 8
          },
          "max_turn_seconds": {
            "description": "单轮最长秒数",
            "type": "int",
            "default": 240
          },
          "max_turn_new_tokens": {
            "description": "一条用户消息完整轮次新增 Token 上限",
            "type": "int",
            "default": 13200,
            "hint": "只估算本轮新增，不含缓存命中的历史；包含本轮所有模型与工具步骤，不是单次工具调用。0=不限。"
          }
        }
      }
    }
  },
  "compression": {
    "description": "旧对话压缩",
    "hint": "默认使用确定性首尾截断，不调用模型，不产生额外 Token。",
    "type": "object",
    "items": {
      "hard_threshold_chars": {
        "description": "兜底压缩字符数",
        "hint": "按窗口推荐（字符）：24条→105,000；48条→131,000；72条→160,000；90条→175,000；极限→189,000。",
        "type": "int",
        "default": 160000
      },
      "hard_threshold_tokens": {
        "description": "兜底压缩估算 Token",
        "hint": "按窗口推荐（Token）：24条→58,000；48条→72,000；72条→88,000；90条→96,000；极限→104,000。",
        "type": "int",
        "default": 88000
      },
      "enabled": {
        "description": "启用旧对话压缩",
        "type": "bool",
        "default": true
      },
      "keep_ratio": {
        "description": "旧文本保留比例",
        "hint": "压缩后旧文本保留比例；默认 0.333。",
        "type": "float",
        "default": 0.333
      },
      "min_chars": {
        "description": "最小压缩长度",
        "type": "int",
        "default": 16000,
        "hint": "按窗口推荐：24条→10,000；48条→14,000；72条→16,000；90条→20,000；极限→24,000。"
      },
      "cache_friendly": {
        "description": "保留前缀以利用 Prompt Cache",
        "hint": "开启后最前面的消息不参与压缩/去重/图片替换/工具裁剪，减少缓存前缀变化。",
        "type": "bool",
        "default": true
      },
      "cache_prefix_messages": {
        "description": "保留前缀消息数",
        "hint": "计算：上下文窗口条数 ÷ 3。推荐 8/16/24/30/极限；极限 50 条。",
        "type": "int",
        "default": 24
      },
      "hard_threshold_ratio": {
        "description": "兜底压缩阈值比例",
        "type": "float",
        "default": 0.756,
        "hint": "自动阈值默认关闭；仅在开启自动模式时生效。"
      }
    }
  },
  "tools": {
    "description": "工具调用",
    "hint": "只处理完整调用对，避免留下孤立 tool 消息。",
    "type": "object",
    "items": {
      "keep_recent_turns": {
        "description": "工具消息保留轮数",
        "hint": "只清理该轮数之前的工具调用/结果。",
        "type": "int",
        "default": 12
      },
      "skip_cleanup": {
        "description": "跳过工具消息清理",
        "hint": "默认关闭；检测到其他工具压缩插件时自动跳过；手动开启会始终跳过工具消息清理。",
        "type": "bool",
        "default": false
      },
      "max_current_result_chars": {
        "description": "当前用户轮单条工具结果硬上限",
        "hint": "只截断当前用户轮内每一条工具结果，单条上限，不是本轮合计；旧结果之后按“历史旧工具结果单条压缩上限”再压缩。",
        "type": "int",
        "default": 3000
      },
      "summarize_long": {
        "description": "截断超长工具结果",
        "hint": "默认开启：只截断旧工具结果一次，带截断标记；不会重复截断。",
        "type": "bool",
        "default": true
      },
      "max_result_chars": {
        "description": "历史旧工具结果单条压缩上限",
        "type": "int",
        "default": 1500,
        "hint": "只处理当前轮之外、超出最近保护范围的旧工具结果，按单条截断，不是合计预算。"
      },
      "ttl_minutes": {
        "description": "工具调用保留分钟数",
        "hint": "历史消息带时间戳时按时间判断；没有时间戳时按保留对数处理。推荐 45/55/65/75/90；活跃期间不清理。",
        "type": "int",
        "default": 65
      },
      "keep_recent_pairs": {
        "description": "保留最近工具调用对数",
        "type": "int",
        "default": 3
      },
      "remove_orphan": {
        "description": "删除孤立 tool 消息",
        "hint": "没有对应 tool_call 的结果会清理；关闭后保留。",
        "type": "bool",
        "default": true
      },
      "cleanup": {
        "description": "工具定义清理",
        "hint": "默认清理所有工具；不改参数 schema 和 handler。",
        "type": "object",
        "items": {
          "enabled": {
            "description": "启用工具定义清理",
            "type": "bool",
            "default": true
          },
          "mode": {
            "description": "清理模式",
            "hint": "weak 只去 inactive/重复/空白；strong 额外截断超长描述。",
            "type": "string",
            "options": [
              "weak",
              "strong"
            ],
            "default": "weak"
          },
          "remove_inactive": {
            "description": "移除 inactive 工具",
            "type": "bool",
            "default": true
          },
          "normalize_whitespace": {
            "description": "清理工具描述空白",
            "type": "bool",
            "default": true
          },
          "deduplicate": {
            "description": "按工具名去重",
            "type": "bool",
            "default": true
          },
          "strong": {
            "description": "强力清理参数",
            "hint": "仅在 mode=strong 时生效；默认只截断官方工具描述。",
            "type": "object",
            "items": {
              "max_description_chars": {
                "description": "工具描述最大字符数",
                "type": "int",
                "default": 1200,
                "hint": "仅在 mode=strong 时生效；默认 1200，第三方工具描述较长可调到 2000–3000。"
              },
              "protected_tool_patterns": {
                "description": "受保护工具关键词",
                "hint": "名称或描述命中这些词的工具不截断描述。",
                "type": "list",
                "default": [
                  "memory",
                  "remember",
                  "记忆",
                  "日记",
                  "rag"
                ]
              }
            }
          }
        }
      },
      "gating": {
        "description": "官方工具门控",
        "hint": "独立功能：按消息内容只提供相关官方工具；第三方插件工具永远保留。",
        "type": "object",
        "items": {
          "enabled": {
            "description": "启用官方工具门控",
            "type": "bool",
            "default": false
          },
          "fallback_all": {
            "description": "不确定时保留全部官方工具",
            "hint": "建议保持开启。",
            "type": "bool",
            "default": true
          },
          "keep_recent_minutes": {
            "description": "保留最近使用工具分钟数",
            "type": "int",
            "default": 25,
            "hint": "最近使用过的官方工具继续保留的分钟数；建议 25-30，减少工具列表变化。"
          },
          "official_tool_names": {
            "description": "官方工具补充白名单",
            "hint": "除了这里列出的名字，还会根据 handler 模块路径自动识别 astrbot.core/builtin_stars 工具；不要填第三方插件工具。",
            "type": "list",
            "default": [
              "astrbot_execute_shell",
              "astrbot_execute_python",
              "astrbot_execute_ipython",
              "astrbot_execute_browser",
              "astrbot_execute_browser_batch"
            ]
          }
        }
      }
    }
  },
  "images": {
    "description": "图片",
    "hint": "只替换旧上下文中的图片引用，不删除原始文件。",
    "type": "object",
    "items": {
      "clean_old": {
        "description": "替换旧图片",
        "type": "bool",
        "default": false,
        "hint": "默认关闭，避免事后替换旧图片造成缓存失效；需要清旧图时再开。"
      },
      "placeholder": {
        "description": "无标签时的图片占位文本",
        "type": "string",
        "default": "[图片已省略]"
      },
      "keep_labels": {
        "description": "保留图片短标签",
        "hint": "从 alt/caption/emotion/tag 等字段提取 2-4 字标签。",
        "type": "bool",
        "default": true
      },
      "max_label_chars": {
        "description": "图片标签最大字符数",
        "hint": "限制在 2-4 字符。",
        "type": "int",
        "default": 4
      },
      "only_base64": {
        "description": "清理旧图时只处理内联 Base64",
        "hint": "只影响旧图片占位清理；新图描述仍可读取受信任本地路径或公网图片。",
        "type": "bool",
        "default": true
      },
      "ingest_caption": {
        "description": "图片入库短描述",
        "hint": "首次遇到新图时调用图片 Provider 生成标签+描述；会产生额外模型调用和 Token。",
        "type": "bool",
        "default": true
      },
      "caption_provider_id": {
        "description": "图片描述 Provider",
        "hint": "留空回退当前聊天 Provider；需要该 Provider 支持图片输入。",
        "type": "string",
        "default": ""
      },
      "tag_max_chars": {
        "description": "图片标签最大字数",
        "type": "int",
        "default": 4
      },
      "desc_max_chars": {
        "description": "图片描述最大字数",
        "type": "int",
        "default": 15
      },
      "artifact_retention_days": {
        "description": "图片原图保留天数",
        "type": "int",
        "default": 15,
        "hint": "图片原图 artifact 保留天数；默认 15，过期会被清理。"
      },
      "artifact_max_files": {
        "description": "图片原图最大文件数",
        "type": "int",
        "default": 240
      },
      "caption_failure_ttl_seconds": {
        "description": "描述失败重试间隔秒数",
        "type": "int",
        "default": 60,
        "hint": "图片描述失败后，多久允许重试；默认 60 秒。"
      }
    }
  },
  "persistent": {
    "description": "持久清理（高风险）",
    "hint": "默认关闭；只通过 ConversationManager 官方 API 写入，并先做逻辑备份。",
    "type": "object",
    "items": {
      "allow": {
        "description": "允许持久清理",
        "hint": "关闭时只做每轮请求过滤；开启后管理员才能执行 run/restore。",
        "type": "bool",
        "default": false
      },
      "require_admin": {
        "description": "仅管理员执行",
        "type": "bool",
        "default": true
      },
      "admin_ids": {
        "description": "显式管理员 ID",
        "hint": "可选。与 admin_names 任一命中即可执行持久命令。",
        "type": "list",
        "default": []
      },
      "admin_names": {
        "description": "显式管理员账号名称",
        "hint": "区分大小写，使用发送者显示名；与 admin_ids 任一命中即可。",
        "type": "list",
        "default": []
      },
      "require_confirmation": {
        "description": "持久清理需要确认",
        "hint": "开启后必须使用 /节省上下文 run confirm。",
        "type": "bool",
        "default": true
      },
      "encrypt_backups": {
        "description": "加密逻辑备份",
        "hint": "使用本地随机密钥 AES-GCM 加密；关闭后备份为明文 JSON。",
        "type": "bool",
        "default": true
      },
      "allow_legacy_plaintext_backups": {
        "description": "允许恢复旧明文备份",
        "hint": "默认关闭；开启后 restore 才接受旧的 .json 明文备份。",
        "type": "bool",
        "default": false
      },
      "audit_log": {
        "description": "记录持久操作审计",
        "hint": "只记录时间、发送者、会话、操作和统计，不记录消息正文。",
        "type": "bool",
        "default": true
      },
      "command_cooldown_seconds": {
        "description": "持久命令冷却秒数",
        "type": "int",
        "default": 120
      },
      "backup_retention_days": {
        "description": "逻辑备份保留天数",
        "type": "int",
        "default": 15
      }
    }
  },
  "reminder": {
    "description": "system_reminder",
    "hint": "只处理历史中的提醒块，当前消息保留最新一条。",
    "type": "object",
    "items": {
      "dedupe": {
        "description": "去重历史提醒",
        "type": "bool",
        "default": true
      },
      "keep_latest": {
        "description": "保留当前消息最新提醒",
        "hint": "关闭后当前消息的提醒也可能被移除，不建议关闭。",
        "type": "bool",
        "default": true
      }
    }
  }
}
